{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vroom",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-01",
  // better-auth reaches for node:crypto and AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Worker-first only where a route actually handles a non-GET request, or the
    // asset layer answers 405 and silently breaks every form post. It is NOT
    // "/*": that also captures Vite's dev module URLs (/app/*, /@react-router/*,
    // /@id/*), which then reach the React Router handler, match no route, and
    // 404 — the app renders but never hydrates. Every route exporting an action
    // lives under /api/* or the /ws upgrade; keep this list in step with
    // app/routes.ts.
    "run_worker_first": ["/api/*", "/ws"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "CampusRoom" }],
  },
  // new_sqlite_classes is not optional: key-value backed classes do not exist
  // on the Workers free plan (VRIP-03).
  //
  // v2 and v3 are the clean start for VRIP-13: the rooms begin empty under
  // CampusRoom, and v3 erases every message written under handles from the old
  // database along with RoomDurableObject. They had to be separate deploys:
  // Cloudflare refuses to delete a class the live version still binds. Never
  // remove or reorder these entries; Cloudflare applies each tag once, and
  // editing history here re-runs nothing but breaks the next deploy.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["CampusRoom"] },
    { "tag": "v3", "deleted_classes": ["RoomDurableObject"] },
  ],
  // VRIP-13's edge brake on minting handles, keyed by connecting IP and counted
  // only for a key with no member row. Generous because campus Wi-Fi puts many
  // students behind one address; Turnstile is the brake that stops a script.
  "ratelimits": [
    {
      "name": "NEW_HANDLE_LIMITER",
      "namespace_id": "1301",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
  // The registered production callback is https://vroom.vosslabs.org/... so the
  // Worker must answer on that hostname or the OAuth redirect_uri will not match.
  "routes": [{ "pattern": "vroom.vosslabs.org", "custom_domain": true }],
  "vars": {
    "BETTER_AUTH_URL": "https://vroom.vosslabs.org",
    "VROOMS_ORIGIN": "https://vroom.vosslabs.org",
    "VAUTH_DISCOVERY_URL": "https://accounts.vosslabs.org/api/auth/.well-known/openid-configuration",
    // "off" refuses new V Auth sign-ins;
    // existing sessions keep working. Students use device keys and are not
    // affected (VRIP-13). Set back to "on" and redeploy to reopen.
    "VAUTH_SIGN_IN": "off",
    "APP_JWT_TTL_SECONDS": "900",
    "RATE_LIMIT_MESSAGES_PER_MINUTE": "20",
    "RATE_LIMIT_HISTORY_PER_MINUTE": "30",
    "MESSAGE_MAX_CHARS": "500",
  },
}
