# Template. Copy to .env (migrations run on Node and read it via dotenv) and to
# .dev.vars (wrangler and the vite plugin read that one for the Worker). Both are
# gitignored; this template is not. Generate each secret per environment with
# openssl rand -base64 32, and never reuse one across environments.

VAUTH_SIGN_IN=off
VAUTH_DISCOVERY_URL=https://accounts.vosslabs.org/api/auth/.well-known/openid-configuration
VAUTH_CLIENT_ID=
VAUTH_CLIENT_SECRET=
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=

# App session JWT handed to the browser to open a socket. Carries the pseudonym
# and room claim only, never the email or the V Auth subject. Generate a fresh
# secret per environment. Never reuse or commit.
APP_JWT_SECRET=
APP_JWT_TTL_SECONDS=900

# Signs the device-key challenge and the student session cookie (VRIP-13).
# Separate from APP_JWT_SECRET so rotating one never logs out the other.
DEVICE_SESSION_SECRET=

# Neon Postgres. DATABASE_URL is the pooled string used over the serverless HTTP
# driver at runtime. DIRECT_URL is the unpooled string used only by migrations,
# which run on Node over a TCP Pool and never on the Worker.
DATABASE_URL=

DIRECT_URL=

RATE_LIMIT_MESSAGES_PER_MINUTE=20
# Backfill is the more expensive frame, so it carries its own budget.
RATE_LIMIT_HISTORY_PER_MINUTE=30
MESSAGE_MAX_CHARS=500

VROOMS_ORIGIN=http://localhost:5173
